JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated allowed origins. Lovable dev server runs on port 8080.
FRONTEND_URL=http://localhost:3000,http://localhost:8080
# Optional; defaults to backend/reklama.db
# DATABASE_PATH=backend/reklama.db

# Email verification via Resend (resend.com — free tier: 100 emails/day).
# Without this, verification codes are printed to the server console (dev only).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM=Reklama.uz <onboarding@resend.dev>
