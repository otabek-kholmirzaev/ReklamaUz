JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated allowed origins. Lovable dev server runs on port 8080.
FRONTEND_URL=http://localhost:3000,http://localhost:8080
# Optional; defaults to backend/reklama.db
# DATABASE_PATH=backend/reklama.db

# Email verification (SMTP). Without these, codes are printed to the server console (dev only).
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=Reklama.uz <you@gmail.com>
